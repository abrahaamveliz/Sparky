# Inference endpoint (Anthropic-compatible API)
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
MODEL_ID=claude-sonnet-4-5

# Display name shown throughout the UI and used by the agent
VITE_PRODUCT_NAME=Sparky
PRODUCT_NAME=Sparky

# Optional: logo URL used as favicon
VITE_LOGO_URL=

# Three illustrative icons shown in the delivery popover
VITE_NAV_BAR_ASSET_1=
VITE_NAV_BAR_ASSET_2=
VITE_NAV_BAR_ASSET_3=

# Avatar shown next to assistant messages
VITE_AGENT_AVATAR_URL=

# Hero banner illustration
VITE_BANNER_1=

# --- OWASP Security ---

# Anti-replay challenge token signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
CHALLENGE_SECRET=

# Cloudflare Turnstile (anti-bot) — https://developers.cloudflare.com/turnstile/
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Upstash Redis (rate limiting & nonce store) — https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=