# LLM proxy (deployed on HF Spaces, OCR Arena backend, all model families)
LLM_PROXY_URL=https://abrahaamveliz-llm-proxy.hf.space
LLM_PROXY_API_KEY=

# Walmart GT MCP server (deployed on HF Spaces)
WALMART_MCP_URL=https://abrahaamveliz-myspace.hf.space/mcp
WALMART_MCP_API_KEY=

# Display name shown throughout the UI and used by the agent to refer to itself.
# VITE_PRODUCT_NAME → exposed to the client; PRODUCT_NAME → read by the server-side
# system prompt. Both default to "Wally" if unset.
VITE_PRODUCT_NAME=Wally
PRODUCT_NAME=Wally

# Optional: logo URL used as favicon. Leave empty to fall back to the bundled
# /public/favicon.svg.
VITE_LOGO_URL=

# Three illustrative icons shown in the delivery popover (Envío / Recogida /
# Domicilio). Leave empty to hide that row.
VITE_NAV_BAR_ASSET_1=
VITE_NAV_BAR_ASSET_2=
VITE_NAV_BAR_ASSET_3=

# Avatar shown next to assistant messages. Leave empty to use the bundled Spark SVG.
VITE_AGENT_AVATAR_URL=

# Hero banner illustration shown above the FAQ. Leave empty to hide the banner.
VITE_BANNER_1=
